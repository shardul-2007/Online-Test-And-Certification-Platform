# ========================================================
# Campus Crew OS — Environment Configuration Reference
# ========================================================

# Supabase Public Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Certificate Generator Engine (Certify HackerRank)
# Defaults to https://certify-hackerrank.vercel.app if omitted
CERTIFY_HACKERRANK_API_URL=https://certify-hackerrank.vercel.app
