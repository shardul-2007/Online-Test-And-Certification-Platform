# ========================================================
# NMIET & ISTE Online Assessment & Certification Platform
# ========================================================

# Public App URL (Used for verification links & QR code URLs)
NEXT_PUBLIC_APP_URL=https://certify-testfdp.vercel.app

# --------------------------------------------------------
# EMAIL AUTOMATION CONFIGURATION (Choose Option A, B, or C)
# --------------------------------------------------------

# OPTION A: Free Direct Delivery via Gmail App Password (Recommended & Instant)
# 1. Go to Google Account -> Security -> 2-Step Verification
# 2. Open https://myaccount.google.com/apppasswords
# 3. Create an App name (e.g. "NMIET Certificate Platform") and copy the 16-character password
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OPTION B: Standard SMTP (Brevo, Mailgun, Amazon SES, or College Mail Server)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_login
# SMTP_PASS=your_password
# SMTP_FROM="Department of IT, NMIET" <fdp@nmiet.edu.in>

# OPTION C: Resend API
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL=certificates@yourdomain.edu.in
