  "questions": [
    {
      "id": "q-1",
      "testId": "test-web-dev-1",
      "text": "Which HTML5 semantic element represents a self-contained composition in a document that is intended to be independently distributable or reusable?",
      "type": "MULTIPLE_CHOICE",
      "marks": 1,
      "order": 1,
      "category": "HTML",
      "explanation": "<article> is intended for self-contained syndicatable content such as blog posts, news stories, or forum entries, whereas <section> represents a generic thematic grouping.",
      "options": []
    },
    {
      "id": "q-2",
      "testId": "test-web-dev-1",
      "text": "If an element has `box-sizing: border-box`, `width: 300px`, `padding: 20px`, and `border: 2px solid #000`, what is its final rendered total width on screen?",
      "type": "MULTIPLE_CHOICE",
      "marks": 1,
      "order": 2,
      "category": "CSS",
      "explanation": "Under border-box sizing, padding and border are contained within the declared 300px width. The rendered total width is exactly 300px.",
      "options": []
    },
    {
      "id": "q-3",
      "testId": "test-web-dev-1",
      "text": "In CSS Flexbox, which property controls alignment along the cross axis (perpendicular to the main axis)?",
      "type": "MULTIPLE_CHOICE",
      "marks": 1,
      "order": 3,
      "category": "CSS",
      "explanation": "`justify-content` defines alignment along the main axis, while `align-items` defines how flex items align along the cross axis.",
      "options": []
    },
    {
      "id": "q-4",
      "testId": "test-web-dev-1",
      "text": "In the JavaScript Event Loop, which queue has priority and drains completely before the next macrotask is processed?",
      "type": "MULTIPLE_CHOICE",
      "marks": 1,
      "order": 4,
      "category": "JavaScript",
      "explanation": "Microtasks (Promises, queueMicrotask, MutationObserver) have higher priority than macrotasks (setTimeout, setInterval, I/O) and the microtask queue must be empty before the next macrotask executes.",
      "options": []
    },
    {
      "id": "q-5",
      "testId": "test-web-dev-1",
      "text": "What will be the output of `console.log(typeof null)` in JavaScript?",
      "type": "MULTIPLE_CHOICE",
      "marks": 1,
      "order": 5,
      "category": "JavaScript",
      "explanation": "Due to a historical bug in the first implementation of JavaScript where object type tags were represented by 0, `typeof null` returns \"object\".",
      "options": []
    },
    {
      "id": "q-6",
      "testId": "test-web-dev-1",
      "text": "True or False: Arrow functions in JavaScript retain lexical scoping for `this` and do not bind their own `this`, `arguments`, or `super`.",
      "type": "TRUE_FALSE",
      "marks": 1,
      "order": 6,
      "category": "JavaScript",
      "explanation": "True. Arrow functions do not have their own `this` context; they inherit `this` from the enclosing lexical scope.",
      "options": []
    },
    {
      "id": "q-7",
      "testId": "test-web-dev-1",
      "text": "In React, why should component state never be directly mutated (e.g., `user.name = \"Alex\"`) instead of using setter functions?",
      "type": "MULTIPLE_CHOICE",
      "marks": 1,
      "order": 7,
      "category": "React",
      "explanation": "Direct mutations do not change object references, causing React to miss state changes in shallow comparison, preventing component re-renders.",
      "options": []
    },
    {
      "id": "q-8",
      "testId": "test-web-dev-1",
      "text": "In React, when does the cleanup function returned by `useEffect` execute?",
      "type": "MULTIPLE_CHOICE",
      "marks": 1,
      "order": 8,
      "category": "React",
      "explanation": "The cleanup function executes before the component re-runs the effect on dependency change, as well as when the component unmounts.",
      "options": []
    },
    {
      "id": "q-9",
      "testId": "test-web-dev-1",
      "text": "True or False: In Git, `git rebase` creates a new merge commit preserving both branch histories verbatim, whereas `git merge` rewrites commit hashes linearly.",
      "type": "TRUE_FALSE",
      "marks": 1,
      "order": 9,
      "category": "Git",
      "explanation": "False. `git merge` preserves histories and creates a merge commit, while `git rebase` replays commits onto a new base, rewriting commit hashes.",
      "options": []
    },
    {
      "id": "q-10",
      "testId": "test-web-dev-1",
      "text": "What is the precise difference between HTTP status code 401 Unauthorized and 403 Forbidden?",
      "type": "MULTIPLE_CHOICE",
      "marks": 1,
      "order": 10,
      "category": "Web Fundamentals",
      "explanation": "401 indicates missing or invalid authentication credentials (user identity unknown), while 403 means the identity is authenticated but lacks permission to access the resource.",
      "options": []
    }
  ],
